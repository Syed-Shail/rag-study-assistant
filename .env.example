# Model provider: auto (OpenAI when OPENAI_API_KEY is set, otherwise local Ollama), openai, or ollama.
LLM_PROVIDER=auto

# OpenAI (default when a key is present)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama (offline mode). Download the models first with `ollama pull`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional configuration
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=study_materials
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
# Leave empty to use the calibrated default for the provider's embedding model.
RELEVANCE_CUTOFF=
RETRIEVAL_MODE=hybrid
# Re-attach each answer sentence to the passage that supports it.
REPAIR_CITATIONS=true
MAX_FILE_MB=25
