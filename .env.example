# Ollama must be running locally and these models must be downloaded with `ollama pull`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional configuration
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=study_materials_ollama
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_FILE_MB=25
